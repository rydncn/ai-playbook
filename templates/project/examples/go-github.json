{
  "playbook": "1.0.0",
  "tickets": { "source": "github" },
  "commands": {
    "test": "go test -count=1 -race -shuffle=on ./...",
    "e2e": "go test -count=1 -tags=e2e ./e2e/...",
    "lint": "go vet ./...",
    "format": "gofmt -w .",
    "formatCheck": "test -z \"$(gofmt -l .)\""
  },
  "oneWayPaths": ["internal/auth/"],
  "checks": ["review-gate", "criteria", "dependency-audit"]
}
