{
  "playbook": "1.0.0",
  "tickets": { "source": "github" },
  "commands": {
    "test": "uv run pytest -n auto",
    "e2e": "uv run pytest tests/acceptance -n auto",
    "lint": "uv run ruff check .",
    "typecheck": "uv run mypy .",
    "format": "uv run ruff format .",
    "formatCheck": "uv run ruff format --check ."
  },
  "checks": ["review-gate", "criteria", "mutation"]
}
