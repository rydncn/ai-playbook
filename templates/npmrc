# Copy to .npmrc at the project root (and in any sub-project with its own
# package.json). Supply-chain hardening for npm. Compromised packages spread
# by publishing a bad version and running code from an install script within
# hours, before anyone notices; these settings close both doors.

# Don't run packages' install scripts. A package that genuinely needs its
# script (a native build, say) gets it run explicitly, `npm rebuild <name>`,
# with the reason in an ADR.
ignore-scripts=true

# Don't install a version published less than 7 days ago, so bad releases are
# caught and pulled first. Needs npm 11.10 or later; older npm ignores it
# without a word, which is why CI checks the version. Match Dependabot's
# cooldown to it.
min-release-age=7

# Record exact versions, so the lockfile and package.json say the same thing.
save-exact=true
