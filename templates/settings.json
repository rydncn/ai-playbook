{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(gh release *)",
      "Bash(npm publish*)",
      "Bash(npm run deploy*)",
      "Bash(npm run release*)",
      "Bash(*supabase db push*)",
      "Bash(*supabase functions deploy*)",
      "Bash(*supabase secrets *)",
      "Bash(*supabase * --linked*)",
      "Bash(*eas update*)",
      "Bash(*eas build*)",
      "Bash(*eas submit*)",
      "Bash(*vercel deploy*)",
      "Bash(*vercel --prod*)",
      "Bash(*vercel promote*)",
      "Bash(*vercel env *)",
      "Bash(terraform apply*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)"
    ],
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test:ci*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx prettier --check *)",
      "Bash(npx eslint *)"
    ]
  }
}
